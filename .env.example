# 示例环境变量文件 - 复制此文件为 .env 并填写真实值
# cp .env.example .env

# SQL Server SA 密码（至少8位，含大小写字母+数字+特殊字符）
SA_PASSWORD=ChangeMe_StrongPassword123!

# JWT 签名密钥（至少 32 字符，务必使用随机强密钥）
JWT_KEY=

# 可选：xxapi.cn API Key（未配置时句子翻译使用免费接口）
XXAPI_API_KEY=

# 服务器 IP 或域名（用于 CORS 配置，只填 IP 或域名，不要加 http://）
SERVER_IP=your-server-ip
