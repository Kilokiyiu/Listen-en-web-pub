# 示例环境变量文件 - 复制此文件为 .env 并填写真实值
# cp .env.example .env

# SQL Server 密码
SA_PASSWORD=YourStrong!Pass123

# JWT 签名密钥（至少 32 字符）
JWT_KEY=your-production-32char-secret-key!!

# 可选：xxapi.cn API Key（未配置时句子翻译使用免费接口）
XXAPI_API_KEY=

# 服务器 IP（用于 CORS 配置，只填 IP 或域名，不要加 http://）
SERVER_IP=your-server-ip

# 优先 SMTP（推荐 Outlook）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 可选 SendCloud（未配置 SMTP 时使用）
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=
