# ============================================
# Listen-En-Web 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# .env 文件不要提交到版本控制系统！
# ============================================

# SQL Server 数据库密码（必填）
SA_PASSWORD=your-strong-sql-server-password

# JWT 认证密钥（必填，至少32个字符）
JWT_KEY=your-32-char-secret-key-minimum

# ============================================
# 可选配置（通常使用默认值即可）
# ============================================

# JWT 发行者和受众（可选，有默认值）
# JWT_ISSUER=Listen-en-web
# JWT_AUDIENCE=Listen-en-web
