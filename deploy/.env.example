SA_PASSWORD=ChangeMe_StrongPassword123!
JWT_KEY=
# 可选：xxapi.cn API Key（未配置时句子翻译使用免费接口）
XXAPI_API_KEY=
# 只填 IP 或域名，不要带 http://，例如：123.45.67.89 或 example.com
SERVER_IP=your-server-ip-or-domain

# 优先用 SMTP 发反馈到邮箱（推荐 Outlook，可避开 SendCloud 共享 IP 被拉黑）
# Outlook: Host=smtp-mail.outlook.com  Port=587
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ListenEase
FEEDBACK_RECIPIENT_EMAIL=

# 可选：SendCloud（未配置 SMTP 时才会使用；共享 IP 可能被 Outlook 拒收）
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=

# 可选：API 域名（用于配置 CORS，允许的源），不填默认使用 SERVER_IP
# 多个域名用逗号分隔，如：https://example.com,https://www.example.com
CORS_ORIGIN_0=https://your-domain.com
CORS_ORIGIN_1=https://www.your-domain.com