{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": [
    "http://localhost:8080",
    "http://localhost:5173"
  ],
  "ConnectionStrings": {
    "DatabaseConnStr": "${DatabaseConnStr}"
  },
  "JWT": {
    "Issuer": "${JWT_ISSUER:-Listen-en-web}",
    "Audience": "${JWT_AUDIENCE:-Listen-en-web}",
    "Key": "${JWT_KEY}",
    "ExpireSeconds": 86400
  }
}